{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/always-on.mjs\"",
            "timeout": 30,
            "statusMessage": "get-to-it: checking always-on mode..."
          }
        ]
      }
    ]
  }
}
